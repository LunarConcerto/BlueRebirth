<UserControl x:Class="BlueOath.Launcher.Wpf.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BlueOath.Launcher.Wpf.ViewModels">

    <Grid>
        <Rectangle Fill="{StaticResource BgDarkBrush}" />

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="公告"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="18"
                               Margin="0,0,0,12" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Announcements}"
                             SelectedItem="{Binding SelectedAnnouncement}"
                             Style="{StaticResource AnnouncementListBoxStyle}"
                             DisplayMemberPath="Title" />

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="0" Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedAnnouncement.Title}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <Border Grid.Row="1" HorizontalAlignment="Left"
                                    Padding="6,2" CornerRadius="3" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAnnouncement.Severity}" Value="warning">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedAnnouncement.Severity}" Value="error">
                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedAnnouncement.Severity}" Value="info">
                                                <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedAnnouncement.Severity}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="White" TextAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding SelectedAnnouncement.Version, StringFormat='v{0}'}"
                                       Style="{StaticResource BodyTextStyle}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedAnnouncement.Content}"
                                           Style="{StaticResource BodyTextStyle}"
                                           LineHeight="20" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="苍蓝誓约重生版"
                               Style="{StaticResource TitleTextStyle}"
                               FontSize="48"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}" />

                    <TextBlock Text="唯一指定QQ群：701619932"
                               Style="{StaticResource SubtitleTextStyle}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding StatusText}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />

                    <Border HorizontalAlignment="Center" Margin="0,16,0,0"
                            Visibility="{Binding IsLaunching, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="启动中..."
                                       FontSize="13"
                                       Foreground="{StaticResource InfoBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="启动游戏"
                            Style="{StaticResource PrimaryLaunchButtonStyle}"
                            Command="{Binding LaunchCommand}"
                            IsEnabled="{Binding IsLaunching, Converter={StaticResource BooleanInvertConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="调试启动"
                                Style="{StaticResource DebugLaunchButtonStyle}"
                                Command="{Binding DebugLaunchCommand}"
                                IsEnabled="{Binding IsLaunching, Converter={StaticResource BooleanInvertConverter}}" />

                        <TextBlock Text="(不启动服务器)"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                    Padding="0,4,0,0" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Version}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text=" | " FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="日服客户端 v1.4.0" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>