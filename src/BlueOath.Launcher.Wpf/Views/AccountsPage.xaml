<UserControl x:Class="BlueOath.Launcher.Wpf.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgDarkBrush}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="账号管理" Style="{StaticResource TitleTextStyle}" FontSize="24" />
                    <TextBlock Text="{Binding ActiveAccountText}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,14" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount}"
                         Style="{StaticResource AnnouncementListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Id}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="新增账号" Style="{StaticResource SubtitleTextStyle}" FontSize="13" />
                    <TextBox Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SettingTextBoxStyle}" MaxLength="32" Margin="0,8,0,8" />
                    <Button Content="新增并设为当前账号" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding AddCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="账号详情" Style="{StaticResource TitleTextStyle}" FontSize="22" />
                <TextBlock Text="账号名称" Style="{StaticResource SubtitleTextStyle}"
                           FontSize="13" Margin="0,24,0,8" />
                <TextBox Text="{Binding EditAccountName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SettingTextBoxStyle}" MaxLength="32" Width="420"
                         HorizontalAlignment="Left" />

                <TextBlock Text="档案 ID" Style="{StaticResource SubtitleTextStyle}"
                           FontSize="13" Margin="0,20,0,8" />
                <Border Background="{StaticResource BgLightBrush}" CornerRadius="4" Padding="10,8" Width="420"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SelectedAccount.Id}" FontFamily="Consolas"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Content="保存名称" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RenameCommand}" Margin="0,0,10,0" />
                    <Button Content="设为当前账号" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SetActiveCommand}" Margin="0,0,10,0" />
                    <Button Content="移除" Style="{StaticResource DangerButtonStyle}" Width="90"
                            Command="{Binding RemoveCommand}" />
                </StackPanel>

                <Border Background="{StaticResource BgMediumBrush}" CornerRadius="6" Padding="14"
                        Margin="0,28,0,0" HorizontalAlignment="Stretch">
                    <TextBlock Style="{StaticResource BodyTextStyle}" LineHeight="20"
                               Text="每个账号对应一份独立的本地游戏存档。切换账号后，下次启动游戏时生效。移除账号只会删除启动器中的账号入口，不会删除存档数据。" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
