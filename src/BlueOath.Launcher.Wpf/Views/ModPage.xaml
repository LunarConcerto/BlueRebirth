<UserControl x:Class="BlueOath.Launcher.Wpf.Views.ModPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BlueOath.Launcher.Wpf.Models">

    <Grid>
        <Rectangle Fill="{StaticResource BgDarkBrush}" />

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mod 管理" Style="{StaticResource TitleTextStyle}" FontSize="22"
                               VerticalAlignment="Center" />
                    <Button Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Width="80" Height="30"
                            FontSize="12" Command="{Binding RefreshCommand}" Margin="16,0,0,0" />
                    <Button Content="返回启动页" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="30"
                            FontSize="12" Command="{Binding BackCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Left: Mod List -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mod 列表" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                             Style="{StaticResource AnnouncementListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ModInfo}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="14,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="启用/禁用" Width="60" Height="22"
                                                FontSize="10" Background="Transparent"
                                                BorderBrush="{StaticResource TextMutedBrush}"
                                                BorderThickness="1" Foreground="{StaticResource TextSecondaryBrush}"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Mod Description -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedMod.DisplayName}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Padding="6,2" CornerRadius="3" Margin="0,0,8,0"
                                    MinWidth="44" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMod.Enabled}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedMod.Enabled}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedMod.StatusText}" FontSize="10" FontWeight="SemiBold"
                                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding SelectedMod.Version, StringFormat='版本 v{0}'}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Content="{Binding SelectedMod.ToggleActionText}"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="28"
                                    FontSize="12" Command="{Binding ToggleSelectedModCommand}"
                                    Margin="16,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="ID" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,2" />
                        <TextBlock Text="{Binding SelectedMod.Id}" Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Text="描述" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SelectedMod.Description}" Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="目标客户端" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SelectedMod.TargetClientsText}" Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Text="依赖" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SelectedMod.DependenciesText}" Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Text="加载顺序" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SelectedMod.LoadOrder}" Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Text="入口文件" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SelectedMod.Entry}" Style="{StaticResource BodyTextStyle}" />

                        <TextBlock Text="所在目录" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SelectedMod.Directory}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>