<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <SelfContained>true</SelfContained> <!-- 开启自包含 -->
    <PublishSingleFile>true</PublishSingleFile> <!-- 打包为单文件 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>BlueOath.Launcher.Wpf</AssemblyName>
    <RootNamespace>BlueOath.Launcher.Wpf</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <VersionFile>$(MSBuildProjectDirectory)\version.txt</VersionFile>
    <VersionOutput>$(MSBuildProjectDirectory)\VersionInfo.g.cs</VersionOutput>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\announcements.json" />
    <Resource Include="Resources\app.ico" />
    <None Include="launcher-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <!-- Explicit target: invoke it directly when a release needs a version bump. -->
  <Target Name="IncrementLauncherVersion">
    <ReadLinesFromFile File="$(VersionFile)">
      <Output TaskParameter="Lines" ItemName="VersionToIncrementLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <VersionToIncrement>@(VersionToIncrementLines)</VersionToIncrement>
      <VersionMajor>$([System.String]::new('$(VersionToIncrement)').Split('.')[0])</VersionMajor>
      <VersionMinor>$([System.String]::new('$(VersionToIncrement)').Split('.')[1])</VersionMinor>
      <VersionBuild>$([System.String]::new('$(VersionToIncrement)').Split('.')[2])</VersionBuild>
      <IncrementedVersion>$(VersionMajor).$(VersionMinor).$([MSBuild]::Add($(VersionBuild), 1))</IncrementedVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionFile)" Lines="$(IncrementedVersion)" Overwrite="true" />
    <Message Importance="high" Text="Launcher version incremented: $(VersionToIncrement) -> $(IncrementedVersion)" />
  </Target>

  <Target Name="GenerateVersion" BeforeTargets="GenerateAssemblyInfo;BeforeBuild">
    <ReadLinesFromFile File="$(VersionFile)">
      <Output TaskParameter="Lines" ItemName="VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <VersionString>@(VersionLines)</VersionString>
      <Version>$(VersionString)</Version>
      <AssemblyVersion>$(VersionString)</AssemblyVersion>
      <FileVersion>$(VersionString)</FileVersion>
      <InformationalVersion>$(VersionString)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <VersionCodeLines Include="namespace BlueOath.Launcher.Wpf" />
      <VersionCodeLines Include="{" />
      <VersionCodeLines Include="    internal static class VersionInfo" />
      <VersionCodeLines Include="    {" />
      <VersionCodeLines Include="$([System.String]::Format('        public const string Version = &quot;{0}&quot;;', '$(VersionString)'))" />
      <VersionCodeLines Include="    }" />
      <VersionCodeLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(VersionOutput)" Lines="@(VersionCodeLines)" Overwrite="true" />
  </Target>
</Project>
