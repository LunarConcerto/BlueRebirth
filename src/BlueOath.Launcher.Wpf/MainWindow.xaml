<Window x:Class="BlueOath.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlueOath.Launcher.Wpf.ViewModels"
        xmlns:views="clr-namespace:BlueOath.Launcher.Wpf.Views"
        Title="BlueOath Rebirth 启动器"
        Icon="Resources/app.ico"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LaunchViewModel}">
            <views:LaunchPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GuardianViewModel}">
            <views:GuardianPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BgMediumBrush}"
                Padding="16,0"
                Height="44">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="BlueOath Rebirth"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="140,0,0,0">
                    <Button Content="启动"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="0"
                            Margin="0,0,4,0" />
                    <Button Content="守护"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="30"
                            FontSize="12"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="1"
                            Margin="0,0,4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentPage}" />
    </Grid>
</Window>